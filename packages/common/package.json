{
  "name": "@atlas/common",
  "version": "0.1.0",
  "private": true,
  "description": "Shared domain and runtime foundation for the Atlas Kernel.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome format . --write",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4"
  }
}
